{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/spa",
  "cleanUrls": true,
  "redirects": [
    { "source": "/login", "destination": "/#/login", "permanent": false },
    { "source": "/dashboard", "destination": "/#/dashboard", "permanent": false },
    { "source": "/mail2task", "destination": "/#/mail2task", "permanent": false },
    { "source": "/source-intake", "destination": "/#/mail2task", "permanent": false },
    { "source": "/inbound", "destination": "/#/inbound", "permanent": false },
    { "source": "/outbound", "destination": "/#/outbound", "permanent": false }
  ]
}
