# Production multi-stage Dockerfile — optimized for small image size

# Stage 1: Build dependencies
FROM python:3.12-slim AS builder

WORKDIR /build
COPY pyproject.toml .
# Install only the project dependencies (cache-friendly: this layer survives code changes)
RUN python -c "import tomllib; deps = tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']; open('requirements.txt','w').write('\n'.join(deps))" \
    && pip install --no-cache-dir --prefix=/install -r requirements.txt

# Stage 2: Production
FROM python:3.12-slim

# System deps for weasyprint (PDF generation)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 \
    libffi-dev libcairo2 curl && \
    rm -rf /var/lib/apt/lists/*

# Non-root user
RUN groupadd -r wms && useradd -r -g wms wms

WORKDIR /app
COPY --from=builder /install /usr/local
COPY . .

RUN chmod +x docker-entrypoint.sh && chown -R wms:wms /app
USER wms

EXPOSE 8000

# Runs alembic upgrade head (unless RUN_MIGRATIONS=false), then starts uvicorn.
# Respects Render's PORT; workers via WEB_CONCURRENCY (default 2).
CMD ["./docker-entrypoint.sh"]
