# =============================================================================
# WMS QuickStart - Backend Environment Variables
# Copy to .env and fill in values
# =============================================================================

# --- Core ---
DEBUG=true
# DATABASE_URL=postgresql+asyncpg://wms:wms@localhost:5432/wms
DATABASE_URL=sqlite+aiosqlite:///./wms_dev.db
REDIS_URL=redis://localhost:6379/0

# --- Authentication ---
# Leave blank in dev (auto-generates per session, sessions won't survive restarts)
# MUST set in production or startup will fail
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- URLs ---
API_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:5173

# --- Stripe (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI Agent Team (optional, set API key to activate) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M1

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
